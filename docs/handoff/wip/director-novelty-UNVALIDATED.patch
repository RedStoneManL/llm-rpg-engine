+def _select_novel_entry(original, entries, recent, oracle, *, neutral=frozenset()):
+    """Keep an eligible original draw; otherwise redraw without retry loops.
+
+    If a custom table is smaller than the cooldown, relax to its least-recently
+    used entries. A one-entry table still fires rather than deadlocking pacing.
+    """
+    blocked = set(recent) - neutral
+    if original.get("name") not in blocked:
+        return original, False
+    eligible = [entry for entry in entries if entry.get("name") not in blocked]
+    relaxed = not eligible
+    if relaxed:
+        last_seen = {name: index for index, name in enumerate(recent)}
+        oldest = min(last_seen.get(entry.get("name"), -1) for entry in entries)
+        eligible = [entry for entry in entries if last_seen.get(entry.get("name"), -1) == oldest]
+    return oracle.draw(eligible), relaxed
+
+
+def _novel_seed(seed, events, tables, seed_int, policy):
+    """Event-sourced novelty, using separate seeded draws from pacing RNG."""
+    history = [event.get("deltas") or {} for event in events
+               if event.get("type") == "director_fired" and not event.get("retracted")]
+    result = dict(seed)
+    audit = {"version": 1, "twist_window": policy.twist_window,
+             "event_type_window": policy.event_type_window}
+    for key, table, window, neutral, salt in (
+        ("event_type", "event_types", policy.event_type_window, frozenset(), 201),
+        ("twist", "twists", policy.twist_window, _NEUTRAL_TWISTS, 202),
+    ):
+        recent = [row.get(key) for row in history[-window:]] if window else []
+        selected, relaxed = _select_novel_entry(
+            seed[key], tables[table], recent,
+            Oracle(scene_seed(seed_int, salt)), neutral=neutral,
+        )
+        result[key] = selected
+        audit[key] = {"original": seed[key]["name"], "selected": selected["name"],
+                      "recent": recent, "relaxed": relaxed}
+    return result, audit
+
